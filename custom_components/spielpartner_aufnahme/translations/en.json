  "services": {
    "aufnahme_vorbereiten": {
      "name": "Prepare recording",
      "description": "Creates folders, checks for a new season, sets path and file names in OBS and creates the Discord thread if needed.",
      "fields": {
        "spielpartner": {
          "name": "Player",
          "description": "Player (identifier or display name)"
        }
      }
    },
    "dateiformat_anwenden": {
      "name": "Apply file format to OBS",
      "description": "Writes the file names (with cam abbreviation) to all matching OBS filters again.",
      "fields": {
        "spielpartner": {
          "name": "Player",
          "description": "Player (identifier or display name) - empty = active"
        }
      }
    },
    "aufnahme_zaehlen": {
      "name": "Count recording",
      "description": "Adds one to 'recordings in season' and 'total' (normally automatic at the end of a recording).",
      "fields": {
        "spielpartner": {
          "name": "Player",
          "description": "Player (identifier or display name) - empty = active"
        }
      }
    },
    "aufnahme_posten": {
      "name": "Post status",
      "description": "Posts video IDs, swing position and snapshots to the season thread.",
      "fields": {
        "spielpartner": {
          "name": "Player",
          "description": "Player (identifier or display name) - empty = active"
        }
      }
    },
    "zaehler_setzen": {
      "name": "Set counters",
      "description": "Sets season, recordings in season and/or total to fixed values.",
      "fields": {
        "spielpartner": {
          "name": "Player",
          "description": "Player (identifier or display name)"
        },
        "saison": {
          "name": "Saison",
          "description": "New season number"
        },
        "aufnahmen_in_saison": {
          "name": "Recordings in season",
          "description": "New value"
        },
        "gesamt": {
          "name": "Total recordings",
          "description": "New value"
        }
      }
    },
    "recorder_starten": {
      "name": "Start recorder",
      "description": "Starts recording all cams via the add-on.",
      "fields": {
        "spielpartner": {
          "name": "Spielpartner",
          "description": "empty = active"
        }
      }
    },
    "recorder_stoppen": {
      "name": "Stop recorder",
      "description": "Stops the recording cleanly and counts it.",
      "fields": {}
    }
  },
